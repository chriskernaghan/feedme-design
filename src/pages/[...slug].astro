---
import { getEntry, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import CiteThis from '../components/CiteThis.astro';
import Sources from '../components/Sources.astro';
import DatasetBox from '../components/DatasetBox.astro';
import KeyFinding from '../components/KeyFinding.astro';
import Avatar from '../components/Avatar.astro';
import Cover from '../components/Cover.astro';
import { SITE, TYPE_LABELS, TYPE_TONE, formatDate, isoDate, topicLabel, getArticles, readingTime, articleUrl } from '../lib/site';

export const getStaticPaths = (async () => {
  const articles = await getArticles();
  return articles.map((article) => ({
    params: { slug: articleUrl(article).replace(/^\/|\/$/g, '') },
    props: { article },
  }));
}) satisfies GetStaticPaths;

const { article } = Astro.props;
const { data } = article;
const { Content } = await render(article);
const author = await getEntry(data.author);
const authorName = author?.data.name ?? 'Editorial';
const authorUrl = author ? new URL(`/authors/${author.id}/`, SITE.url).href : SITE.url;
const pageUrl = new URL(Astro.url.pathname, SITE.url).href;

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: data.title,
    description: data.description,
    datePublished: data.pubDate.toISOString(),
    dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
    mainEntityOfPage: pageUrl,
    author: { '@type': 'Person', name: authorName, url: authorUrl },
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    keywords: data.topics.map(topicLabel).join(', '),
    inLanguage: 'en-GB',
    citation: data.sources.map((s) => s.url),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Articles', item: `${SITE.url}/articles/` },
      { '@type': 'ListItem', position: 3, name: data.title, item: pageUrl },
    ],
  },
];

if (data.dataset) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: data.dataset.name,
    description: data.description,
    url: pageUrl,
    creator: { '@type': 'Person', name: authorName },
    publisher: { '@type': 'Organization', name: SITE.name },
    datePublished: data.pubDate.toISOString(),
    measurementTechnique: data.dataset.method,
    ...(data.dataset.downloadUrl && {
      distribution: { '@type': 'DataDownload', encodingFormat: 'text/csv', contentUrl: data.dataset.downloadUrl },
    }),
  });
}

---

<BaseLayout title={data.title} description={data.description} type="article" jsonLd={jsonLd} noindex={data.draft} image={data.image?.src}>
  <article>
    <header class="article-head">
      <span class={`tag tone-${TYPE_TONE[data.type]}`}>{TYPE_LABELS[data.type]}</span>
      <h1>{data.title}</h1>
      <div class="article-meta">
        <span class="by"><Avatar name={authorName} /><a href={`/authors/${author?.id}/`}>{authorName}</a></span>
        <time datetime={isoDate(data.pubDate)}>{formatDate(data.pubDate)}</time>
        <span>{readingTime(article.body)}</span>
        {data.updatedDate && <span>Updated <time datetime={isoDate(data.updatedDate)}>{formatDate(data.updatedDate)}</time></span>}
      </div>
    </header>

    <figure class="article-cover">
      <Cover type={data.type} title={data.title} stat={data.cover?.stat} caption={data.cover?.caption} image={data.image} />
      {data.image && (
        <figcaption>
          {data.image.credit}, {data.image.licence}.
          {data.image.sourceUrl && <> <a href={data.image.sourceUrl} rel="noopener">Source</a></>}
        </figcaption>
      )}
    </figure>

    {data.keyFinding && <KeyFinding text={data.keyFinding} tone={TYPE_TONE[data.type]} />}

    <div class="article-body">
      <Content />
    </div>

    {data.dataset && <DatasetBox dataset={data.dataset} />}
    <Sources sources={data.sources} />
    <CiteThis title={data.title} author={authorName} pubDate={data.pubDate} path={Astro.url.pathname} />

    {data.topics.length > 0 && (
      <ul class="tags" aria-label="Topics">
        {data.topics.map((t) => <li><a href={`/topics/${t}/`}>{topicLabel(t)}</a></li>)}
      </ul>
    )}

    {author && (
      <aside class="author-box">
        <Avatar name={authorName} large />
        <div>
          <p class="name"><a href={`/authors/${author.id}/`}>{authorName}</a>, {author.data.role}</p>
          <p class="muted">{author.data.short}</p>
        </div>
      </aside>
    )}
  </article>
</BaseLayout>