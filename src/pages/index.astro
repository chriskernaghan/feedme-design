---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Tabs from '../components/Tabs.astro';
import MascotFace from '../components/MascotFace.astro';
import { SITE, getArticles } from '../lib/site';

const articles = await getArticles();
const latest = articles.slice(0, 7);
const [first, ...rest] = latest;
const authorNames = new Map<string, string>();
for (const a of latest) {
  const author = await getEntry(a.data.author);
  authorNames.set(a.id, author?.data.name ?? 'Editorial');
}

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
    description: SITE.description,
  },
];
---

<BaseLayout title={SITE.name} jsonLd={jsonLd}>
  <section class="intro">
    <h1>E-commerce UX, picked apart.</h1>
    <p>We take real shops apart, measure what we can, and show our working so you can cite it.</p>
  </section>
  <Tabs active="all" />

  {first ? (
    <>
      <div style="height: 2rem"></div>
      <ArticleCard article={first} authorName={authorNames.get(first.id)!} feature />
      {rest.length > 0 && (
        <div class="posts">
          {rest.map((a) => <ArticleCard article={a} authorName={authorNames.get(a.id)!} />)}
        </div>
      )}
    </>
  ) : (
    <div class="empty">
      <MascotFace />
      <p>Nothing published yet. The first pieces land soon.</p>
    </div>
  )}

  <section class="working" aria-labelledby="working-heading">
    <div class="wrap">
      <h2 id="working-heading">We show our working</h2>
      <div class="working-grid">
        <p><strong>We state the sample.</strong>Every study says how many shops, which shops and when we measured them.</p>
        <p><strong>We date the screenshots.</strong>Shops change their designs constantly, so each image carries the day we took it.</p>
        <p><strong>We link the sources.</strong>Third-party figures point to the original publisher, with the date we last checked.</p>
      </div>
      <p class="more"><a href="/methodology/">Read the full method</a></p>
    </div>
  </section>
</BaseLayout>
