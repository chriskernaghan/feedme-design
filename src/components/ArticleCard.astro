---
import type { CollectionEntry } from 'astro:content';
import { TYPE_LABELS, TYPE_TONE, articleUrl, formatDate, isoDate } from '../lib/site';
import Avatar from './Avatar.astro';
import Cover from './Cover.astro';

interface Props {
  article: CollectionEntry<'articles'>;
  authorName: string;
  feature?: boolean;
}
const { article, authorName, feature = false } = Astro.props;
const { data } = article;
const href = articleUrl(article);
const tone = TYPE_TONE[data.type];
---

<article class={feature ? 'feature' : 'post'}>
  <a class="cover-link" href={href} tabindex="-1" aria-hidden="true">
    <Cover type={data.type} title={data.title} stat={data.cover?.stat} caption={data.cover?.caption} image={data.image} />
  </a>
  <div class={feature ? 'text' : 'post-body'} style={feature ? undefined : 'display: contents'}>
    <div class="post-meta">
      <span class={`tag tone-${tone}`}>{TYPE_LABELS[data.type]}</span>
      <time datetime={isoDate(data.pubDate)}>{formatDate(data.pubDate)}</time>
      {data.draft && <span class="draft-flag">Draft</span>}
    </div>
    <h3><a href={href}>{data.title}</a></h3>
    {feature && data.keyFinding && <p class="finding">{data.keyFinding}</p>}
    <p class="excerpt">{data.description}</p>
    <div class="by"><Avatar name={authorName} /><strong>{authorName}</strong></div>
  </div>
</article>