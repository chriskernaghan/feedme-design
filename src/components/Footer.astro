---
import { SITE } from '../lib/site';
import MascotFace from './MascotFace.astro';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <MascotFace />
        <div>
          <h2>{SITE.name}</h2>
          <p>Original breakdowns and data on how online shops work. Get new pieces by email, or use the RSS feed if you prefer a reader.</p>
          <a class="btn btn-primary" href="https://www.wearefounders.uk/#/portal/signup" data-subscribe>Subscribe by email</a>
        </div>
      </div>
      <ul class="footer-links">
        <li><a href="/articles/">All articles</a></li>
        <li><a href="/methodology/">How we measure</a></li>
        <li><a href="/about/">About {SITE.name}</a></li>
        <li><a href="/rss.xml">RSS feed</a></li>
        <li><a href="/sitemap-index.xml">Sitemap</a></li>
      </ul>
    </div>
    <p class="footer-small">&copy; {year} {SITE.name}. You can cite our data with a link back to the page it came from.</p>
  </div>
</footer>
