---
import { formatDate, isoDate } from '../lib/site';

interface Props {
  sources: { title: string; publisher: string; url: string; accessed: Date }[];
}
const { sources } = Astro.props;
---

{sources.length > 0 && (
  <section class="sources" aria-labelledby="sources-heading">
    <h2 id="sources-heading">Sources</h2>
    <ol>
      {sources.map((s) => (
        <li>
          <a href={s.url} rel="noopener">{s.title}</a>, {s.publisher}.
          <span class="muted"> Accessed <time datetime={isoDate(s.accessed)}>{formatDate(s.accessed)}</time>.</span>
        </li>
      ))}
    </ol>
  </section>
)}
