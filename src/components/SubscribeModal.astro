---
import MascotFace from './MascotFace.astro';
---

<dialog id="subscribe-modal" class="subscribe" aria-labelledby="subscribe-title">
  <button class="subscribe-close" type="button" aria-label="Close" data-close>
    <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M4 4l12 12M16 4L4 16" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg>
  </button>
  <div class="subscribe-body">
    <p class="subscribe-lockup">
      <MascotFace />
      <span class="x" aria-hidden="true">&times;</span>
      <strong>We Are Founders</strong>
    </p>
    <h2 id="subscribe-title">feedme.design in partnership with We Are Founders</h2>
    <p>feedme.design shares its newsletter with We Are Founders, so there's one list rather than two. Sign up below and you'll join the We Are Founders newsletter, with stories, insights and resources for people building businesses. You can unsubscribe at any time.</p>
    <div id="subscribe-slot" class="subscribe-slot"></div>
    <p class="subscribe-alt">
      The form not loading? <a href="https://www.wearefounders.uk/#/portal/signup" rel="noopener">Sign up on wearefounders.uk</a>, or follow us by <a href="/rss.xml">RSS</a> instead.
    </p>
  </div>
</dialog>

<script>
  const dialog = document.getElementById('subscribe-modal') as HTMLDialogElement | null;
  const slot = document.getElementById('subscribe-slot');
  let loaded = false;

  // The Ghost form is only fetched the first time someone opens the modal, so it costs nothing on a normal page view.
  function loadForm() {
    if (loaded || !slot) return;
    loaded = true;
    const s = document.createElement('script');
    s.src = 'https://cdn.jsdelivr.net/ghost/signup-form@~0.4/umd/signup-form.min.js';
    s.async = true;
    const attrs: Record<string, string> = {
      'data-background-color': '#08090c',
      'data-text-color': '#FFFFFF',
      'data-button-color': '#443fde',
      'data-button-text-color': '#FFFFFF',
      'data-title': 'We Are Founders',
      'data-description':
        'Discover inspiring stories, valuable insights, and essential resources for entrepreneurs. Connect with a vibrant community of founders and grow your business.',
      'data-icon':
        'https://storage.ghost.io/c/c5/85/c585318c-fe61-416d-a96c-16a9cb374d06/content/images/size/w192h192/2025/02/we-are-founders-w.png',
      'data-site': 'https://www.wearefounders.uk/',
      'data-locale': 'en',
      // Tags everyone who joins from this site, so you can see where they came from in Ghost.
      'data-label-1': 'feedme-design',
    };
    for (const [k, v] of Object.entries(attrs)) s.setAttribute(k, v);
    slot.appendChild(s);
  }

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('[data-subscribe]') && dialog) {
      e.preventDefault();
      loadForm();
      dialog.showModal();
    } else if (target.closest('[data-close]') || target === dialog) {
      dialog?.close();
    }
  });
</script>
