---
import { SITE, formatDate } from '../lib/site';

interface Props {
  title: string;
  author: string;
  pubDate: Date;
  path: string;
}
const { title, author, pubDate, path } = Astro.props;
const url = new URL(path, SITE.url).href;
const year = pubDate.getUTCFullYear();
const plain = `${author} (${year}). ${title}. ${SITE.name}. ${formatDate(pubDate)}. ${url}`;
---

<aside class="cite" aria-labelledby="cite-heading">
  <h2 id="cite-heading">Cite this</h2>
  <p class="cite-text">{plain}</p>
  <p class="muted small">Quote the figures freely, with a link back to this page.</p>
</aside>
